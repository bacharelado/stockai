# Copie para .env e substitua todos os valores antes de iniciar o sistema.
STOCKAI_ENV=production
STOCKAI_REQUIRE_AUTH=true
STOCKAI_ADMIN_USERNAME=admin
STOCKAI_ADMIN_PASSWORD=troque-por-uma-senha-longa-e-unica
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
STOCKAI_SESSION_SECRET=troque-por-um-segredo-aleatorio-longo
STOCKAI_INITIAL_COMPANY_NAME=Minha empresa
STOCKAI_DATABASE_URL=sqlite:///./stockai.db
STOCKAI_AUTO_CREATE_SCHEMA=true
# Inclua apenas domínios que devem servir o app. Para uso somente local:
STOCKAI_ALLOWED_HOSTS=127.0.0.1,localhost
